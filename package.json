{
  "name": "gamified-language-learning",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:watch": "turbo watch test",
    "lint": "eslint .",
    "test:eslint-config": "vitest run --project tooling",
    "typecheck": "turbo typecheck",
    "engine:mock-db": "tsx packages/srs-engine/demo/learning-runner.ts",
    "dev:all": "docker compose up -d && concurrently -n server,web -c blue,green \"pnpm --filter @gll/server dev\" \"pnpm --filter @gll/srs-demo dev\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.1",
    "tsx": "^4",
    "turbo": "^2",
    "typescript": "^5.7",
    "typescript-eslint": "^8",
    "vitest": "^3"
  },
  "dependencies": {
    "vue-router": "^4.6.4"
  }
}
